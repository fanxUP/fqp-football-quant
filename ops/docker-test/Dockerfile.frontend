FROM node:24-bookworm-slim AS build
WORKDIR /src/apps/frontend
COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /src/apps/frontend/dist/ /usr/share/nginx/html/
COPY ops/docker-test/nginx.conf /etc/nginx/conf.d/default.conf
ARG FQP_REVISION=unknown
LABEL org.opencontainers.image.revision=$FQP_REVISION
EXPOSE 80
