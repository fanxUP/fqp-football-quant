# FQP 任务计划示例
# 注意：以下模块路径对应 scripts/jobs/ 目录，实际调度由 Scheduler 容器负责
05 00 * * * python -m scripts.jobs.initialize_business_day
10 00 * * * python -m scripts.jobs.crawl_official_schedule
00 06 * * * python -m scripts.jobs.crawl_official_odds --label morning
00 09 * * * python -m scripts.jobs.generate_predictions --label morning
00 12 * * * python -m scripts.jobs.crawl_official_odds --label midday
00 16 * * * python -m scripts.jobs.generate_recommendations
*/30 * * * * python -m scripts.jobs.settle_matches
00 08 * * * python -m scripts.jobs.generate_daily_review
00 09 * * 1 python -m scripts.jobs.generate_weekly_review
00 10 1 * * python -m scripts.jobs.generate_monthly_review
