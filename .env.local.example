# Host-process development configuration (no Docker Desktop required).
FQP_MODE=local_development
# 新安装默认启用单管理员登录；默认密码：admin123。
# 已使用单引号保护 bcrypt 哈希中的 "$"，避免被本地启动脚本展开。
FQP_AUTH_MODE=session
FQP_ADMIN_PASSWORD_HASH='$2b$12$7KBgTUvuPTHko3vnYDualuRizQa6ARItKWMzMPxnjuV2drbpJ/.P.'
FQP_SESSION_TTL=86400
# 用于加密保存在数据库中的模型服务商 API 密钥。生产环境请使用随机 32 字符以上私有值；不得提交。
FQP_PROVIDER_ENCRYPTION_KEY=
FQP_DAILY_BUDGET=500
FQP_THEME=red_black_tech
FQP_BIND_HOST=127.0.0.1

# Homebrew PostgreSQL is the only source of truth for this project.
DATABASE_URL=postgresql://fqp:fqp_local_password@127.0.0.1:5432/fqp
# Concurrent dashboard reads share this bounded pool. Saturated requests wait
# briefly instead of failing immediately with an HTTP 500.
FQP_DB_POOL_MIN=2
FQP_DB_POOL_MAX=16
FQP_DB_POOL_ACQUIRE_TIMEOUT=15

# Redis is optional for most interactive development paths. Configure it when
# running scheduler/worker jobs locally.
REDIS_URL=redis://127.0.0.1:6379/0

OFFICIAL_SOURCE_ENABLED=true
SPORTTERY_BASE_URL=https://webapi.sporttery.cn/gateway/jc/football/
API_FOOTBALL_KEY=
API_FOOTBALL_MIN_INTERVAL_SECONDS=6.1
# Optional post-match evidence collector. Values cap one scheduler run and its
# historical backfill window so the provider quota remains predictable.
UPSET_PROVIDER_EVIDENCE_LIMIT=20
# API-Football free plan exposes only yesterday through tomorrow.
UPSET_PROVIDER_EVIDENCE_LOOKBACK_DAYS=1
# Optional current-season standings provider. If unset, API-Football is used.
SPORTMONKS_API_TOKEN=
